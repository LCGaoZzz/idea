          "type": "string",
          "minLength": 1
        },
        "analysis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "check_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidence_path",
        "selector",
        "expected"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tsv_cell_equals",
            "json_pointer_equals",
            "text_contains",
            "sha256_equals"
          ]
        },
        "evidence_path": {
          "type": "string",
          "minLength": 1
        },
        "selector": {},
        "expected": {}
      }
    },
    "result_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "metric",
        "unit",
        "check",
        "observed",
        "passed",
        "analysis_ids",
        "evidence_paths",
        "verification"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "observed": {},
        "passed": {
          "type": "boolean"
        },
        "analysis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "$ref": "#/$defs/check_verification"
        }
      }
    },
    "observed_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "evidence_paths"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "value": {},
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_basis",
        "status",
        "source_read_only",
        "output_directory",
        "environment",
        "network_used",
        "notes"
      ],
      "properties": {
        "authorization_basis": {
          "type": "string",
