          "enum": [
            "passed",
            "blocked"
          ]
        },
        "source_read_only": {
          "type": "boolean"
        },
        "output_directory": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "enum": [
            "existing",
            "isolated",
            "unavailable"
          ]
        },
        "network_used": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "analysis_ids",
        "command",
        "command_argv",
        "attempt_status",
        "entrypoint",
        "code_evidence_refs",
        "code_snapshot_sha256",
        "code_files",
        "working_directory",
        "started_at_utc",
        "finished_at_utc",
        "exit_code",
        "dependencies",
        "seed",
        "inputs",
        "outputs",
        "stdout_log",
        "stderr_log",
        "checks",
        "checks_sha256",
        "observed_parameters",
        "observed_parameters_sha256",
        "adjudication_status",
        "adjudicated_at_utc",
        "preflight",
        "code_provenance",
        "receipt_path",
        "receipt_sha256",
        "supersedes_execution_ids"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "analysis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
