            "minLength": 1
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "command_argv": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attempt_status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "blocked",
            "pending_checks"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "code_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_snapshot_sha256": {
          "type": "string",
          "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
        },
        "code_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
              }
            }
          }
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": "integer"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "seed": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "const": "not_applicable"
            }
          ]
        },
        "seed_reason": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/execution_artifact"
              },
              {
                "not": {
                  "required": [
                    "analysis_ids"
                  ]
                }
              }
            ]
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/execution_output_artifact"
          }
        },
        "stdout_log": {
          "type": "string",
          "minLength": 1
        },
        "stderr_log": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/result_check"
          }
        },
        "checks_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
        },
        "observed_parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observed_parameter"
          }
        },
        "observed_parameters_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
        },
        "adjudication_status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "pending_checks",
            "blocked"
          ]
        },
        "adjudicated_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "preflight": {
          "$ref": "#/$defs/preflight"
        },
        "code_provenance": {
          "type": "string",
          "enum": [
            "source_exact",
            "source_adapted",
            "generated_guidance"
          ]
        },
        "receipt_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes_execution_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attempt_status": {
                "enum": [
                  "succeeded",
                  "failed"
                ]
              }
            },
            "required": [
              "attempt_status"
            ]
          },
          "then": {
            "properties": {
              "receipt_path": {
                "type": "string",
                "minLength": 1
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
              },
              "checks_sha256": {
                "type": "string",
                "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
              },
              "observed_parameters_sha256": {
                "type": "string",
                "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
              },
              "adjudicated_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attempt_status": {
                "const": "pending_checks"
              }
            },
            "required": [
              "attempt_status"
            ]
          },
          "then": {
            "properties": {
              "receipt_path": {
                "type": "string",
                "minLength": 1
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
              },
              "checks_sha256": {
                "type": "string",
                "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
              },
              "observed_parameters_sha256": {
                "type": "string",
                "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
              },
              "adjudicated_at_utc": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
