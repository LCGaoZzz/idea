{
  "protocol": "custom-jsonl-stdio-v1-not-mcp",
  "tools": [
    {
      "name": "search",
      "description": "Retrieve typed claims and authored Markdown chunks. Scores are lexical relevance, not scientific confidence.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_claim",
      "description": "Read one stable atomic claim with its evidence scope.",
      "input_schema": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^C[0-9]{3}$"
          }
        },
        "required": [
          "claim_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_document",
      "description": "Read one registered local knowledge document, no arbitrary paths.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "build_context",
      "description": "Build an evidence packet for a host LLM. No model call is performed.",
      "input_schema": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5
          }
        },
        "required": [
          "question"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_project",
      "description": "Check declared data capabilities and block unsupported claims; does not execute methods.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "ProjectCapabilityInput",
            "type": "object",
            "required": [
              "project_id",
              "goals"
            ],
            "additionalProperties": false,
            "properties": {
              "has_genotype": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "has_allele_counts": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "has_scDNA": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "has_tree": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "tree_leaf_ids_matched": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "time_calibrated": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "has_patient_id": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "has_spatial": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "project_id": {
                "type": "string"
              },
              "modalities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "goals": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "genotype_phenotype_association",
                    "lineage_heritability",
                    "relative_transition_dynamics",
                    "absolute_transition_rates",
                    "spatial_niche_association"
                  ]
                }
              },
              "genotype_origin": {
                "enum": [
                  "direct",
                  "inferred",
                  "imputed",
                  "none",
                  "unknown"
                ]
              },
              "branch_unit": {
                "enum": [
                  "days",
                  "years",
                  "divisions",
                  "mutations",
                  "normalized",
                  "unknown"
                ]
              },
              "independent_units": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "longitudinal_design": {
                "enum": [
                  "same_subject_repeated",
                  "independent_stage_groups",
                  "none",
                  "unknown"
                ]
              }
            }
          }
        },
        "required": [
          "project"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_tools",
      "description": "Describe this custom JSONL protocol. This is not MCP.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  ]
}
