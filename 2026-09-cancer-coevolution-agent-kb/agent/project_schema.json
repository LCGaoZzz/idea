{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectCapabilityInput",
  "type": "object",
  "required": [
    "project_id",
    "goals"
  ],
  "additionalProperties": false,
  "properties": {
    "has_genotype": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_allele_counts": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_scDNA": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_tree": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "tree_leaf_ids_matched": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "time_calibrated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_patient_id": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_spatial": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "project_id": {
      "type": "string"
    },
    "modalities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "genotype_phenotype_association",
          "lineage_heritability",
          "relative_transition_dynamics",
          "absolute_transition_rates",
          "spatial_niche_association"
        ]
      }
    },
    "genotype_origin": {
      "enum": [
        "direct",
        "inferred",
        "imputed",
        "none",
        "unknown"
      ]
    },
    "branch_unit": {
      "enum": [
        "days",
        "years",
        "divisions",
        "mutations",
        "normalized",
        "unknown"
      ]
    },
    "independent_units": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "longitudinal_design": {
      "enum": [
        "same_subject_repeated",
        "independent_stage_groups",
        "none",
        "unknown"
      ]
    }
  }
}
